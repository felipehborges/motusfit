# --- API ---
# Ausente => PGlite local em .data/ (dev sem Docker).
# Produção (Neon, ADR 0008): sslmode=require é obrigatório.
# DATABASE_URL=postgres://user:pass@host/motusfit?sslmode=require

# Better Auth (gerar: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-in-real-env
BETTER_AUTH_URL=http://localhost:3001

API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# --- Clientes ---
# Web usa proxy (apps/web/next.config.ts) — sem isso o cookie de sessão é
# cross-site e o Safari/iOS bloqueia (ITP). API_URL não é NEXT_PUBLIC_: só o
# servidor do Next (rewrite) precisa dele, o navegador nunca chama a API direto.
API_URL=http://localhost:3001

# Mobile fala com a API direto (não passa por proxy).
EXPO_PUBLIC_API_URL=http://localhost:3001

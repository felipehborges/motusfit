# --- API ---
# Ausente => PGlite local em .data/ (dev sem Docker).
# Produção (Neon, ADR 0008): sslmode=require é obrigatório.
# DATABASE_URL=postgres://user:pass@host/motusfit?sslmode=require

# Better Auth (gerar: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-in-real-env
BETTER_AUTH_URL=http://localhost:3001

API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# --- Clientes ---
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

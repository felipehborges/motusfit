# --- API ---
# Ausente => PGlite local em .data/ (dev sem Docker). Produção: Postgres gerenciado.
# DATABASE_URL=postgres://user:pass@host:5432/motusfit

# Better Auth (gerar: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-in-real-env
BETTER_AUTH_URL=http://localhost:3001

API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Billing (ADR 0008) — opt-in; ausente/false, todo mundo fica no plano free.
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...

# --- Clientes ---
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
